# Copy to .env and fill in real values. Never commit .env.

# Google Gemini API key used by the AI investigation agents (Module 4).
# Optional: if empty, a programmatic report is generated instead.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Mock target server (main.py)
TARGET_PORT=8000
# Path of the structured JSON traffic log written by logger.py
TRAFFIC_LOG_FILE=./traffic.log

# WebSocket bridge (ws_server.py) consumed by the dashboard
WS_PORT=8765

# Frontend: WebSocket URL the dashboard connects to (baked in at build time)
VITE_WS_URL=ws://localhost:8765/ws/dashboard
